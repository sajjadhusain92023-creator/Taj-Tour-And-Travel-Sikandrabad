<!DOCTYPE html> <html lang="hi"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1.0"> <title>Car Tour & Travel Taxi Booking</title> <script src="https://cdn.tailwindcss.com"></script> </head> <body class="bg-slate-100 font-sans text-slate-800"> <div class="max-w-md mx-auto min-h-screen bg-white shadow-xl flex flex-col justify-between"> <!-- HEADER --> <header class="bg-blue-600 text-white p-4 text-center shadow-md"> <h1 class="text-xl font-bold">🚗 Car Tour & Travel</h1> <p class="text-xs text-blue-100">Safe & Reliable Taxi Service</p> </header> <!-- MAIN CONTAINER --> <main class="p-4 flex-grow"> <!-- 1. LOGIN SCREEN --> <div id="loginSection" class="space-y-4 mt-6"> <div class="bg-blue-50 p-4 rounded-xl border border-blue-200 text-center"> <h2 class="font-semibold text-blue-800 text-lg">Apna Mobile Number Darj Karein</h2> <p class="text-xs text-blue-600 mt-1">Booking karne ke liye phone number se login karein</p> </div> <div> <label class="block text-sm font-medium text-gray-700 mb-1">Mobile Number</label> <input type="tel" id="phoneNumber" placeholder="10-digit mobile number" maxlength="10" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"> </div> <button onclick="sendOtp()" class="w-full bg-blue-600 text-white py-3 rounded-lg font-semibold hover:bg-blue-700 transition"> OTP Bhejein </button> </div> <!-- OTP SCREEN --> <div id="otpSection" class="space-y-4 mt-6 hidden"> <div class="bg-amber-50 p-4 rounded-xl border border-amber-200 text-center"> <h2 class="font-semibold text-amber-800 text-lg">OTP Verification</h2> <p class="text-xs text-amber-600 mt-1">Demo OTP: <span class="font-bold">1234</span> enter karein</p> </div> <div> <label class="block text-sm font-medium text-gray-700 mb-1">4-Digit OTP</label> <input type="text" id="otpInput" placeholder="Enter 1234" maxlength="4" class="w-full p-3 border border-gray-300 rounded-lg text-center tracking-widest text-xl font-bold"> </div> <button onclick="verifyOtp()" class="w-full bg-green-600 text-white py-3 rounded-lg font-semibold hover:bg-green-700 transition"> Verify & Login </button> </div> <!-- 2. BOOKING / SEARCH SCREEN --> <div id="bookingSection" class="space-y-4 hidden"> <div class="flex justify-between items-center bg-gray-50 p-3 rounded-lg border"> <span class="text-sm text-gray-600">Logged in: <strong id="displayUserNum" class="text-blue-600"></strong></span> <button onclick="logout()" class="text-xs text-red-500 font-semibold hover:underline">Logout</button> </div> <!-- Admin Button if 9358795114 --> <div id="adminNavBtn" class="hidden"> <button onclick="openAdminPanel()" class="w-full bg-purple-600 text-white py-2 rounded-lg font-semibold text-sm hover:bg-purple-700 transition"> 📊 View Owner History (9358795114) </button> </div> <div class="space-y-3"> <h2 class="font-bold text-gray-800">Trip Detail Daaliye</h2> <div> <label class="block text-xs font-semibold text-gray-600 mb-1">Trip Type</label> <select id="tripType" class="w-full p-2.5 border rounded-lg text-sm bg-white"> <option value="oneway">One-Way Trip (Double Distance)</option> <option value="round">Round Trip (Both Sides)</option> </select> </div> <div> <label class="block text-xs font-semibold text-gray-600 mb-1">Pickup Location</label> <input type="text" id="pickupLoc" placeholder="e.g. Sikandrabad, Noida, Delhi" class="w-full p-2.5 border rounded-lg text-sm"> </div> <div> <label class="block text-xs font-semibold text-gray-600 mb-1">Drop Location</label> <input type="text" id="dropLoc" placeholder="e.g. Delhi Airport, Agra, Meerut" class="w-full p-2.5 border rounded-lg text-sm"> </div> <button onclick="searchCabs()" class="w-full bg-blue-600 text-white py-3 rounded-lg font-semibold hover:bg-blue-700 transition shadow"> Cars & Rates Dekhein </button> </div> <!-- CAR OPTIONS --> <div id="carListSection" class="space-y-3 mt-4 hidden"> <h3 class="font-bold text-gray-800 text-sm">Available Taxis:</h3> <!-- Maruti Swift --> <div class="border rounded-xl p-3 flex justify-between items-center bg-white shadow-sm hover:border-blue-500"> <div> <h4 class="font-bold text-blue-900">Maruti Swift</h4> <p class="text-xs text-gray-500">4 Seater • Comfortable Hatchback</p> <p class="text-xs text-green-600 font-semibold mt-1">Estimated Distance: <span id="swiftDist">0</span> km</p> </div> <div class="text-right"> <div class="text-lg font-extrabold text-blue-600" id="swiftFare">₹0</div> <button onclick="bookCar('Maruti Swift')" class="mt-1 bg-blue-600 text-white text-xs px-3 py-1.5 rounded font-semibold hover:bg-blue-700">Book Now</button> </div> </div> <!-- Maruti XL6 --> <div class="border rounded-xl p-3 flex justify-between items-center bg-white shadow-sm hover:border-blue-500"> <div> <h4 class="font-bold text-purple-900">Maruti XL6</h4> <p class="text-xs text-gray-500">6 Seater • Premium Family MPV</p> <p class="text-xs text-green-600 font-semibold mt-1">Estimated Distance: <span id="xl6Dist">0</span> km</p> </div> <div class="text-right"> <div class="text-lg font-extrabold text-purple-600" id="xl6Fare">₹0</div> <button onclick="bookCar('Maruti XL6')" class="mt-1 bg-purple-600 text-white text-xs px-3 py-1.5 rounded font-semibold hover:bg-purple-700">Book Now</button> </div> </div> </div> </div> <!-- 3. SUCCESS / CONFIRMATION SCREEN --> <div id="successSection" class="text-center space-y-4 mt-10 hidden"> <div class="w-16 h-16 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto text-3xl">✓</div> <h2 class="text-xl font-bold text-green-700">Booking Confirmed!</h2> <p class="text-sm text-gray-600">Aapki booking successfully save ho gayi hai aur Owner ki history (9358795114) mein update kar di gayi hai.</p> <button onclick="resetToBooking()" class="bg-blue-600 text-white px-6 py-2 rounded-lg font-semibold text-sm">Nayi Booking Karein</button> </div> <!-- 4. ADMIN HISTORY SECTION (9358795114) --> <div id="adminSection" class="space-y-4 hidden"> <div class="flex justify-between items-center"> <h2 class="font-bold text-purple-800 text-lg">👑 Owner Dashboard (9358795114)</h2> <button onclick="backToBookingFromAdmin()" class="text-xs bg-gray-200 px-3 py-1 rounded font-semibold">Back</button> </div> <div class="bg-purple-50 p-3 rounded-lg border border-purple-200 flex justify-between items-center"> <div> <p class="text-xs text-purple-600 font-medium">Total Bookings</p> <p id="totalBookingsCount" class="text-xl font-bold text-purple-900">0</p> </div> <button onclick="clearHistory()" class="text-xs text-red-600 bg-white border border-red-300 px-2.5 py-1 rounded shadow-sm">Clear History</button> </div> <div id="historyList" class="space-y-3 max-h-96 overflow-y-auto"> <!-- History items will load here --> </div> </div> </main> <!-- FOOTER --> <footer class="bg-gray-50 p-3 text-center text-xs text-gray-500 border-t"> Car Tour & Travel Service • Contact: 9358795114 </footer> </div> <!-- JAVASCRIPT LOGIC --> <script> let currentUser = ""; let currentBookingData = {}; // LocalStorage based Bookings array for 9358795114 function getBookings() { let data = localStorage.getItem("taxi_bookings_9358795114"); return data ? JSON.parse(data) : []; } function saveBooking(booking) { let list = getBookings(); list.unshift(booking); // add to top localStorage.setItem("taxi_bookings_9358795114", JSON.stringify(list)); } function sendOtp() { let num = document.getElementById("phoneNumber").value.trim(); if(num.length !== 10) { alert("Kripya sahi 10-digit mobile number daaliye!"); return; } currentUser = num; document.getElementById("loginSection").classList.add("hidden"); document.getElementById("otpSection").classList.remove("hidden"); } function verifyOtp() { let otp = document.getElementById("otpInput").value.trim(); if(otp !== "1234") { alert("Galat OTP! Kripya '1234' enter karein."); return; } document.getElementById("otpSection").classList.add("hidden"); document.getElementById("bookingSection").classList.remove("hidden"); document.getElementById("displayUserNum").innerText = currentUser; // Check if owner if(currentUser === "9358795114") { document.getElementById("adminNavBtn").classList.remove("hidden"); } else { document.getElementById("adminNavBtn").classList.add("hidden"); } } function logout() { currentUser = ""; document.getElementById("phoneNumber").value = ""; document.getElementById("otpInput").value = ""; document.getElementById("bookingSection").classList.add("hidden"); document.getElementById("adminSection").classList.add("hidden"); document.getElementById("loginSection").classList.remove("hidden"); } function searchCabs() { let pickup = document.getElementById("pickupLoc").value.trim(); let drop = document.getElementById("dropLoc").value.trim(); let tripType = document.getElementById("tripType").value; if(!pickup || !drop) { alert("Kripya Pickup aur Drop location dono daaliye!"); return; } // Automatic distance generation simulation based on route name / length let baseDist = 45; // default km let combined = (pickup + " " + drop).toLowerCase(); if(combined.includes("airport") || combined.includes("delhi")) baseDist = 75; else if(combined.includes("agra")) baseDist = 180; else if(combined.includes("meerut")) baseDist = 90; else if(combined.includes("noida")) baseDist = 55; else if(combined.includes("bulandshahr")) baseDist = 25; // One-Way rule: Double distance calculation (aana + khali wapas aana) let finalDist = tripType === "oneway" ? baseDist * 2 : baseDist * 2; // round trip is also both sides // Rates: Swift = 16/km, XL6 = 18/km let swiftPrice = finalDist * 16; let xl6Price = finalDist * 18; // Minimum fare guard if(swiftPrice < 800) swiftPrice = 800; if(xl6Price < 1200) xl6Price = 1200; currentBookingData = { pickup: pickup, drop: drop, tripType: tripType === "oneway" ? "One-Way" : "Round Trip", distance: finalDist, swiftFare: swiftPrice, xl6Fare: xl6Price, customerPhone: currentUser, date: new Date().toLocaleString() }; document.getElementById("swiftDist").innerText = finalDist; document.getElementById("xl6Dist").innerText = finalDist; document.getElementById("swiftFare").innerText = "₹" + swiftPrice.toLocaleString(); document.getElementById("xl6Fare").innerText = "₹" + xl6Price.toLocaleString(); document.getElementById("carListSection").classList.remove("hidden"); } function bookCar(carName) { let fare = carName === "Maruti Swift" ? currentBookingData.swiftFare : currentBookingData.xl6Fare; currentBookingData.carBooked = carName; currentBookingData.totalFare = fare; // Save to history visible on 9358795114 saveBooking(currentBookingData); document.getElementById("bookingSection").classList.add("hidden"); document.getElementById("successSection").classList.remove("hidden"); } function resetToBooking() { document.getElementById("successSection").classList.add("hidden"); document.getElementById("carListSection").classList.add("hidden"); document.getElementById("pickupLoc").value = ""; document.getElementById("dropLoc").value = ""; document.getElementById("bookingSection").classList.remove("hidden"); } function openAdminPanel() { document.getElementById("bookingSection").classList.add("hidden"); document.getElementById("adminSection").classList.remove("hidden"); loadAdminHistory(); } function backToBookingFromAdmin() { document.getElementById("adminSection").classList.add("hidden"); document.getElementById("bookingSection").classList.remove("hidden"); } function loadAdminHistory() { let list = getBookings(); document.getElementById("totalBookingsCount").innerText = list.length; let container = document.getElementById("historyList"); if(list.length === 0) { container.innerHTML = `<div class="text-center text-gray-400 py-6 text-sm">Abhi tak koi booking nahi aayi hai.</div>`; return; } let html = ""; list.forEach((b, idx) => { html += ` <div class="bg-white border rounded-xl p-3 shadow-sm space-y-1 text-sm"> <div class="flex justify-between font-bold text-gray-800"> <span>🚗 ${b.carBooked}</span> <span class="text-purple-700">₹${b.totalFare.toLocaleString()}</span> </div> <div class="text-xs text-gray-600"> <p><strong>Customer:</strong> <a href="tel:${b.customerPhone}" class="text-blue-600 underline">${b.customerPhone}</a></p> <p><strong>Route:</strong> ${b.pickup} ➔ ${b.drop} (${b.tripType})</p> <p><strong>Distance:</strong> ${b.distance} km (Calculated)</p> <p class="text-gray-400 mt-1">${b.date}</p> </div> </div> `; }); container.innerHTML = html; } function clearHistory() { if(confirm("Kya aap saari history delete karna chahte hain?")) { localStorage.removeItem("taxi_bookings_9358795114"); loadAdminHistory(); } } </script> </body> </html>
